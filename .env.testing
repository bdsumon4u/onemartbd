APP_NAME=OneMartBD
APP_ENV=testing
APP_KEY=base64:testing
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=sqlite
DB_DATABASE=:memory:

BCRYPT_ROUNDS=4
CACHE_DRIVER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array

# Use these to override other services safely in testing
LOG_CHANNEL=stack
QUEUE_DRIVER=sync

# Ensure any other sensitive services are disabled or stubbed
MAIL_FROM_ADDRESS=test@example.com
MAIL_FROM_NAME="OneMart Test"
